[options]
mode bmc
depth 20

[engines]
smtbmc yices

[script]
-- read all CVW sources
read -sv ../hdl/cvw/config/rv64gc/config.vh
read -sv ../hdl/cvw/config/shared/config-shared.vh
read -sv ../hdl/cvw/config/shared/parameter-defs.vh
read -sv ../hdl/cvw/src/cvw.sv
read -sv -I../hdl/cvw/src -I../hdl/cvw/config/rv64gc -I../hdl/cvw/config/shared \
    $(find ../hdl/cvw/src -name '*.sv' | tr '\n' ' ')
-- read RVFI monitor
read -sv ../hvl/common/rvfimon.v
-- read AMOEBA HDL
read -sv ../hdl/ahb_to_memitf.sv
read -sv ../hdl/cvw_rvfi_wrapper.sv
-- read formal wrapper
read -sv -formal wrapper.sv
hierarchy -check -top formal_wrapper
proc; opt
flatten
prep -top formal_wrapper

[files]
wrapper.sv
../hdl/cvw_rvfi_wrapper.sv
../hdl/ahb_to_memitf.sv
../hvl/common/rvfimon.v
