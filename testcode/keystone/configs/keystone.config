# Kernel config overlay for the Keystone boot test.
#
# Merged ON TOP of testcode/linux/configs/linux_amoeba.config, never instead of
# it: that file is the only known-good configuration for this core, and forking
# it would let the two tests drift apart silently.  Everything here is a
# delta the Keystone test needs and the plain Linux boot does not.

# The Keystone driver, injected into the kernel tree as drivers/keystone by
# testcode/keystone/Makefile.  Built in rather than as a module: CONFIG_MODULES
# stays off (see linux_amoeba.config), so module_init becomes a
# device_initcall and no userspace loader is needed in the initramfs.
CONFIG_KEYSTONE_DRIVER=y

# The driver registers a misc device with MISC_DYNAMIC_MINOR, so the minor is
# assigned at registration.  A static cpio node with a fixed minor would break
# whenever it shifts, so /dev is populated by devtmpfs instead and /init mounts
# it (CONFIG_DEVTMPFS_MOUNT deliberately does not cover initramfs).
CONFIG_DEVTMPFS=y
