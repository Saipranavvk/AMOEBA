# Kernel config fragment for the AMOEBA boot test, merged over riscv defconfig
# by scripts/kconfig/merge_config.sh.
#
# Goal: the smallest Linux 6.6 that reaches /init on a single-hart CVW core.
# Every option here is either (a) removing work the simulator would otherwise
# have to execute, or (b) explicitly keeping a CVW hardware feature turned on
# so the boot actually exercises it.

# ---- Single hart ------------------------------------------------------------
# The RTL has one hart.  Turning SMP off removes IPI handling, CPU hotplug and
# the SMP RCU machinery from the boot path entirely.
# CONFIG_SMP is not set
CONFIG_NR_CPUS=1

# ---- Nothing compressed -----------------------------------------------------
# Decompression is pure wasted simulator cycles.  `make Image` is already
# uncompressed; this keeps the built-in initramfs uncompressed too.
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set

# ---- Console ----------------------------------------------------------------
# The CVW uncore's NS16550 at 0x10000000 is the only output device.  earlycon
# matters more than it looks: without it there is no output at all between the
# kernel entry and console handover, which is exactly the window where early
# boot bugs live.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y

# ---- CVW features we want the boot to actually use --------------------------
# These are the reason a Linux boot is a better core test than any bare-metal
# program: page-table walks, hardware A/D updates, cache-block ops and the
# fence variants only get exercised by a real OS.
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_SVNAPOT=y
CONFIG_RISCV_ISA_SVPBMT=y
CONFIG_RISCV_ISA_ZICBOM=y
CONFIG_RISCV_ISA_ZICBOZ=y
CONFIG_FPU=y
CONFIG_RISCV_SBI=y

# The core implements no vector unit; probing for one only costs a trap.
# CONFIG_RISCV_ISA_V is not set

# ---- Work we do not need ----------------------------------------------------
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_EFI is not set
# CONFIG_MODULES is not set
# CONFIG_NET is not set
# CONFIG_BLOCK is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_MMC is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_INPUT is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_HW_RANDOM is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_PCI is not set
# ACPI is enabled by riscv defconfig and is dead weight here: the platform
# is described entirely by the device tree.
# CONFIG_ACPI is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_PM is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_CPU_FREQ is not set

# ---- crypto self-tests -------------------------------------------------------
# This is a *disable* switch, so it has to be =y.  Left unset, the crypto manager
# runs its full algorithm self-test suite at boot -- software SHA-3 over test
# vectors and much more.  That cost several hundred million simulated cycles and
# made the boot look hung: the soft-lockup watchdog fired repeatedly inside
# keccakf_round() while the kernel was simply working.
CONFIG_CRYPTO_MANAGER_DISABLE_TESTS=y

# Jitter entropy is the other half of the crypto bill, and it is not a self-test
# so DISABLE_TESTS does not touch it.  Seeding the DRBG runs SHA-3 (keccak) over
# many rounds at boot -- measured at 214M cycles, more than half the boot.  It
# also selects CRYPTO_SHA3, which is why disabling SHA3 directly does nothing.
# The device tree supplies an rng-seed instead, which is the normal way to seed
# a machine that has no entropy source.
# Disabling JITTERENTROPY directly does nothing -- it is select'ed, and Kconfig
# select cannot be overridden by a fragment.  The chain is
#   CRYPTO_ECHAINIV -> CRYPTO_RNG_DEFAULT -> CRYPTO_DRBG_MENU -> JITTERENTROPY
# so the selector at the top has to go.  ECHAINIV exists for IPsec, and NET is
# already off here.
# CONFIG_CRYPTO_ECHAINIV is not set
# CONFIG_CRYPTO_JITTERENTROPY is not set
# CONFIG_CRYPTO_DRBG_MENU is not set

# ---- watchdogs ---------------------------------------------------------------
# Pure noise here.  They measure progress against kernel-perceived time, which on
# an RTL simulator bears no relation to how long the work actually took, so they
# fire on healthy boots and bury the console in backtraces.
# CONFIG_SOFTLOCKUP_DETECTOR is not set
# CONFIG_DETECT_HUNG_TASK is not set
# CONFIG_WQ_WATCHDOG is not set

# ---- Debug/instrumentation off ----------------------------------------------
# Each of these adds per-call or per-branch work to code the boot runs millions
# of times.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_KASAN is not set
# CONFIG_KCOV is not set
# CONFIG_LOCKDEP is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_LATENCYTOP is not set

# ---- Timer ------------------------------------------------------------------
# HZ=100 against the 1 MHz timebase the device tree declares means one tick per
# 10,000 simulated cycles.
CONFIG_HZ_100=y
CONFIG_HZ=100
# Periodic ticks only.  High-resolution timers let the kernel program events at
# microsecond granularity; at 100 MHz that is 100 cycles, far less than the ISR
# itself costs, so short hrtimers can re-fire before the handler returns.  A
# plain 100 Hz tick is one interrupt per million cycles and cannot livelock.
CONFIG_HZ_PERIODIC=y
# CONFIG_NO_HZ_IDLE is not set
# CONFIG_HIGH_RES_TIMERS is not set
