# Kernel config delta for CONFIG=baremetal_linux.
#
# Merged AFTER configs/linux_amoeba.config, so it only has to say what differs.
# Everything in the base fragment -- the crypto cuts, the watchdog cuts, HZ=100,
# the console setup -- still applies and is not repeated here.
#
# pkg/config_baremetal_linux.vh is the smallest core that boots Linux, and every
# line below turns off a kernel feature whose hardware that config removed.
# Leaving any of them on makes the kernel issue an instruction the core does not
# implement, which traps to OpenSBI as an illegal instruction and either dies or
# silently costs a trap round trip on a hot path.
#
# The device tree has to agree with this file: dts/amoeba_baremetal_linux.dts
# cuts riscv,isa and riscv,isa-extensions to match.  Both are needed -- the
# kernel gates some of these on the config symbol and some on the DT string.

# ---- No FPU -----------------------------------------------------------------
# F_SUPPORTED = D_SUPPORTED = 0.  This is the change everything else follows
# from.  With CONFIG_FPU=n, arch/riscv/Makefile drops `fd` from riscv-march-y
# (line 60), so neither the C nor the assembly half of the kernel is built
# against an FP-capable -march, and the FP context-switch paths compile out.
#
# The kernel is built -mabi=lp64 either way -- kernel C code never uses FP -- so
# this is not an ABI change for the kernel itself.  Userland is already clear:
# initramfs/init.S is freestanding assembly built -march=rv64imac -mabi=lp64
# and contains no FP instruction, so there is no libc to rebuild soft-float.
# CONFIG_FPU is not set

# ---- Virtual-memory extensions the core does not have -----------------------
# SVNAPOT_SUPPORTED = SVPBMT_SUPPORTED = 0.  Both are PTE-encoding extensions:
# the kernel would set reserved PTE bits that this core's page-table walker does
# not interpret.
# CONFIG_RISCV_ISA_SVNAPOT is not set
# CONFIG_RISCV_ISA_SVPBMT is not set

# SVINVAL_SUPPORTED = 0.  Without it the kernel uses plain sfence.vma, which is
# what the core implements.
# CONFIG_RISCV_ISA_SVINVAL is not set

# Note on A/D bits: SVADU_SUPPORTED = 0, so the hardware raises a page fault
# instead of setting Accessed/Dirty itself.  There is no config symbol for this
# and none is needed -- Svade is the architectural fallback and Linux's RISC-V
# fault handler has always set those bits in software.  Do NOT list "svadu" in
# the device tree.

# ---- Cache-block operations -------------------------------------------------
# ZICBOM_SUPPORTED = ZICBOZ_SUPPORTED = 0.  cbo.clean/flush/inval and cbo.zero
# are all illegal on this core.  The matching riscv,cbom-block-size and
# riscv,cboz-block-size properties are dropped from the device tree.
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set

# ---- Bit manipulation -------------------------------------------------------
# ZBA/ZBB/ZBS/ZBC all removed.  Leaving CONFIG_RISCV_ISA_ZBB=y would not be
# fatal -- the optimized string routines are behind alternatives that only patch
# in when the extension is present -- but it compiles in two copies of each
# routine and costs a boot-time probe for something the DT already says is
# absent.
# CONFIG_RISCV_ISA_ZBB is not set
